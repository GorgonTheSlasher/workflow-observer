# Copy to backend/.env. Only JWT_SECRET is required to run locally with the demo data.

# Signs login tokens. Must be at least 32 bytes; the app refuses to start otherwise.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Defaults to a local SQLite file when unset. Use your Postgres URL in production.
# DATABASE_URL=postgresql://user:password@host:5432/workflow_observer

# Where the GitHub sign-in redirect sends users. Defaults to the Vite dev server.
# FRONTEND_BASE_URL=http://localhost:5173

# Installation id(s) shown through "Try the demo" and to users with no installation yet.
# Comma-separated. Must match the id passed to scripts/seed_demo.py. Empty disables the demo.
DEMO_INSTALLATION_IDS=12345

# GitHub App: needed for live webhooks and "Sign in with GitHub"
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_REDIRECT_URI=http://localhost:8000/github-app/auth
GITHUB_APP_WEBHOOK_SECRET=

# Optional: a repo-level webhook sent to POST /webhook, and the Slack URL its alerts use
# GITHUB_WEBHOOK_SECRET=
# SLACK_WEBHOOK_URL=
